<Window x:Class="LoadLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LoadLens.App.Controls"
        mc:Ignorable="d"
        Title="LoadLens — диагностика лагов"
        Width="1440"
        Height="940"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        TextElement.Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />

        <Style x:Key="GridNumberText" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <DataTemplate x:Key="EvidenceTemplate">
            <Border Margin="0,0,7,7"
                    Padding="9,6"
                    Background="#0CFFFFFF"
                    BorderBrush="#16FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding Label}"
                               FontSize="9"
                               Foreground="#8DA2B7"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="250" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Value}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}"
                                   FontSize="10.5"
                                   Foreground="#7F93A8"
                                   Margin="5,1,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="150" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActionTemplate">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="21" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="18"
                        Height="18"
                        CornerRadius="9"
                        Background="#14FFFFFF"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding Number}"
                               FontSize="9"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#CBD8E6" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="{Binding Text}"
                           Margin="7,0,0,0"
                           FontSize="11"
                           LineHeight="16"
                           Foreground="#C7D5E4"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MetricCardTemplate">
            <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,9,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{Binding Label}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#7C8FA5" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="5"
                                     Height="5"
                                     Fill="{Binding StatusBrush}"
                                     Margin="0,0,5,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Status}"
                                       FontSize="9"
                                       Foreground="{Binding StatusBrush}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Text="{Binding Value}"
                               Margin="0,8,0,0"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="29"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2"
                               Text="{Binding Caption}"
                               Margin="0,0,0,0"
                               FontSize="10.5"
                               Foreground="#74879C"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                        <ProgressBar Style="{StaticResource Meter}"
                                     Value="{Binding Percent, Mode=OneWay}"
                                     Foreground="{Binding Accent}"
                                     Margin="0,11,0,0" />
                        <controls:Sparkline Height="25"
                                            Margin="0,6,0,0"
                                            Values="{Binding Spark}"
                                            Stroke="{Binding Accent}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FindingTemplate">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Background="{Binding Tint}"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding Accent}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}"
                                   Margin="0,3,0,0"
                                   FontSize="10.5"
                                   LineHeight="15"
                                   Foreground="#A8B8C8"
                                   TextWrapping="Wrap"
                                   MaxHeight="32"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               Text="{Binding Badge}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{Binding Accent}"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TopProcessTemplate">
            <Border Height="45" Padding="16,0">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                <Setter Property="Background" Value="#0C5B8CFF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.1*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.78*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="25"
                                Height="25"
                                CornerRadius="7"
                                Background="{Binding Accent}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Initials}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#07111F"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="9.5" Foreground="#667A90" Margin="0,1,0,0">
                                <Run Text="PID " />
                                <Run Text="{Binding Pid, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource GridNumberText}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding MaxThreadText}" Style="{StaticResource GridNumberText}" Foreground="#F5B942" />
                    <TextBlock Grid.Column="3" Text="{Binding GpuText}" Style="{StaticResource GridNumberText}" />
                    <TextBlock Grid.Column="4" Text="{Binding RamText}" Style="{StaticResource GridNumberText}" Foreground="#9AACBF" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#0C1117"
                BorderBrush="#19242F"
                BorderThickness="0,0,1,0">
            <Grid Margin="16,22,16,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6A9AFF" Offset="0" />
                                <GradientStop Color="#A78BFA" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <TextBlock Text="L"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="#08111D"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Ellipse Width="5"
                                     Height="5"
                                     Fill="#08111D"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,8,8,0" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LOADLENS"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="16.5"
                                   FontWeight="Bold" />
                        <TextBlock Text="PC LOAD DIAGNOSTICS"
                                   FontSize="7.5"
                                   Foreground="#64778C"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="НАБЛЮДЕНИЕ"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="#52657A"
                           Margin="12,0,0,7" />

                <StackPanel Grid.Row="3">
                    <RadioButton x:Name="NavOverview"
                                 Style="{StaticResource NavItem}"
                                 Content="Обзор"
                                 Tag="&#xE80F;"
                                 Uid="Overview"
                                 IsChecked="True"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavProcesses"
                                 Style="{StaticResource NavItem}"
                                 Content="Процессы"
                                 Tag="&#xE7C4;"
                                 Uid="Processes"
                                 Checked="Nav_Checked" />
                    <RadioButton x:Name="NavReport"
                                 Style="{StaticResource NavItem}"
                                 Content="Отчёт"
                                 Tag="&#xE8A5;"
                                 Uid="Report"
                                 Checked="Nav_Checked" />
                </StackPanel>

                <Border Grid.Row="4"
                        Margin="0,0,0,12"
                        Padding="12"
                        Background="#0F1821"
                        BorderBrush="#1B2936"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="КАК ЧИТАТЬ"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="#667A90" />
                        <TextBlock Text="100% в колонке «1 поток» — это одно полностью занятое ядро, а не вся система."
                                   Margin="0,6,0,0"
                                   FontSize="10.5"
                                   LineHeight="15"
                                   Foreground="#9BACBE"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="4,0,0,0">
                    <Ellipse Width="5" Height="5" Fill="#3A4B5E" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="v1.0.0 · локально"
                               FontSize="9.5"
                               Foreground="#52657A" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="30,22,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="27"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PageSubtitle}"
                               Margin="0,4,0,0"
                               FontSize="11.5"
                               Foreground="#7E91A6" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0E1A15"
                            BorderBrush="#1E392C"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{Binding StatusBrush}"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding StatusBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding UpdatedText}"
                               Margin="12,0,14,0"
                               FontSize="10.5"
                               Foreground="#667A90"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding TogglePauseCommand}"
                            Padding="11,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PauseGlyph}"
                                       FontSize="9"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PauseButtonText}" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="30,18,30,0">
                <!-- OVERVIEW -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Overview}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,20">
                            <!-- Hero verdict -->
                            <Border CornerRadius="18"
                                    Background="{Binding HeroBrush}"
                                    BorderBrush="#22303E"
                                    BorderThickness="1"
                                    Padding="20"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="284" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,26,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{Binding SeverityTintBrush}"
                                                    CornerRadius="6"
                                                    Padding="8,4">
                                                <TextBlock Text="{Binding SeverityText}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding SeverityBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding ConfidenceText}"
                                                       Margin="10,0,0,0"
                                                       FontSize="10"
                                                       Foreground="#8194A9"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding VerdictTitle}"
                                                   Margin="0,11,0,6"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="25"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="760" />
                                        <TextBlock Text="{Binding VerdictSummary}"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   Foreground="#C4D2E1"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="760" />

                                        <ItemsControl ItemsSource="{Binding Evidence}"
                                                      ItemTemplate="{StaticResource EvidenceTemplate}"
                                                      Margin="0,10,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>

                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="ЧТО СДЕЛАТЬ"
                                                       FontSize="8.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#72869C" />
                                            <ItemsControl ItemsSource="{Binding PrimaryActions}"
                                                          ItemTemplate="{StaticResource ActionTemplate}"
                                                          Margin="0,7,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Target card -->
                                    <Border Grid.Column="1"
                                            Background="#10FFFFFF"
                                            BorderBrush="#1CFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16"
                                            VerticalAlignment="Stretch">
                                        <Grid>
                                            <StackPanel Visibility="{Binding HasTarget, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="В ЦЕНТРЕ ВНИМАНИЯ"
                                                           FontSize="8.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#8396AB" />
                                                <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                                    <Border Width="38"
                                                            Height="38"
                                                            CornerRadius="10"
                                                            Background="{Binding TargetBrush}">
                                                        <TextBlock Text="{Binding TargetInitials}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="#07111F"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TargetName}"
                                                                   FontSize="13.5"
                                                                   FontWeight="SemiBold"
                                                                   MaxWidth="180"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TargetPidText}"
                                                                   FontSize="9.5"
                                                                   Foreground="#74889D"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Height="1" Background="#1AFFFFFF" Margin="0,14,0,12" />
                                                <TextBlock Text="{Binding TargetThreadLabel}"
                                                           FontSize="9.5"
                                                           Foreground="#8598AC" />
                                                <TextBlock Text="{Binding TargetThreadValue}"
                                                           FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="31"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding SeverityBrush}"
                                                           Margin="0,1,0,0" />
                                                <ProgressBar Style="{StaticResource Meter}"
                                                             Value="{Binding TargetThreadPercent, Mode=OneWay}"
                                                             Foreground="{Binding SeverityBrush}"
                                                             Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding TargetNote}"
                                                           Margin="0,10,0,0"
                                                           FontSize="10"
                                                           LineHeight="14"
                                                           Foreground="#8497AB"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding TargetStats}"
                                                           Margin="0,10,0,0"
                                                           FontSize="10"
                                                           Foreground="#A9BBCC"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding ShowHealthyState, Converter={StaticResource BoolVisibility}}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <Border Width="48"
                                                        Height="48"
                                                        CornerRadius="24"
                                                        Background="#1535D07F"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="✓"
                                                               FontSize="23"
                                                               Foreground="#35D07F"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding HealthyTitle}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,12,0,0" />
                                                <TextBlock Text="{Binding HealthyText}"
                                                           FontSize="10"
                                                           Foreground="#8497AB"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           Margin="0,5,0,0"
                                                           MaxWidth="210" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Metric cards -->
                            <ItemsControl ItemsSource="{Binding MetricCards}"
                                          ItemTemplate="{StaticResource MetricCardTemplate}"
                                          Margin="0,0,-9,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- Lower row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="Что ещё влияет"
                                                       Style="{StaticResource SectionTitle}" />
                                            <Border HorizontalAlignment="Right"
                                                    Background="#0FFFFFFF"
                                                    CornerRadius="5"
                                                    Padding="7,2">
                                                <TextBlock Text="{Binding SecondaryCountText}"
                                                           FontSize="9"
                                                           Foreground="#7C8FA5" />
                                            </Border>
                                        </Grid>
                                        <ItemsControl Grid.Row="1"
                                                      ItemsSource="{Binding SecondaryFindings}"
                                                      ItemTemplate="{StaticResource FindingTemplate}"
                                                      Margin="0,12,0,0"
                                                      Visibility="{Binding HasSecondaryFindings, Converter={StaticResource BoolVisibility}}" />
                                        <StackPanel Grid.Row="1"
                                                    Margin="0,14,0,0"
                                                    Visibility="{Binding ShowHealthySecondary, Converter={StaticResource BoolVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✓" Foreground="#35D07F" FontSize="14" />
                                                <TextBlock Text="Других узких мест нет"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="7,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="Проверяем CPU, GPU, RAM, VRAM, диск, троттлинг и DPC каждую секунду."
                                                       FontSize="10.5"
                                                       Foreground="#667A90"
                                                       TextWrapping="Wrap"
                                                       Margin="0,7,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2"
                                                   Text="Каждое наблюдение — это отдельная проверка, а не ещё один график."
                                                   FontSize="9.5"
                                                   Foreground="#52657A"
                                                   Margin="0,10,0,0" />
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        Style="{StaticResource Card}"
                                        Margin="8,0,0,0"
                                        Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="16,14,16,0">
                                            <TextBlock Text="Активные процессы"
                                                       Style="{StaticResource SectionTitle}" />
                                            <Button Content="Все процессы →"
                                                    Style="{StaticResource LinkButton}"
                                                    Command="{Binding ShowProcessesCommand}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="16,10,16,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.1*" />
                                                <ColumnDefinition Width="0.7*" />
                                                <ColumnDefinition Width="0.78*" />
                                                <ColumnDefinition Width="0.7*" />
                                                <ColumnDefinition Width="0.8*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="ПРОЦЕСС" FontSize="8.5" FontWeight="SemiBold" Foreground="#667A90" />
                                            <TextBlock Grid.Column="1" Text="CPU" FontSize="8.5" FontWeight="SemiBold" Foreground="#667A90" TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="1 ПОТОК" FontSize="8.5" FontWeight="SemiBold" Foreground="#667A90" TextAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="GPU" FontSize="8.5" FontWeight="SemiBold" Foreground="#667A90" TextAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="RAM" FontSize="8.5" FontWeight="SemiBold" Foreground="#667A90" TextAlignment="Right" />
                                        </Grid>
                                        <Border Grid.Row="1" Height="1" Background="#18242F" VerticalAlignment="Bottom" Margin="16,0" />
                                        <ItemsControl Grid.Row="2"
                                                      ItemsSource="{Binding TopProcesses}"
                                                      ItemTemplate="{StaticResource TopProcessTemplate}"
                                                      Margin="0,4,0,8" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- PROCESSES -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Processes}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Все процессы"
                                       Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Сортировка по CPU. Раскройте окно шире, чтобы увидеть больше колонок."
                                       Margin="0,4,0,0"
                                       FontSize="10.5"
                                       Foreground="#667A90" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Grid Width="250">
                                <TextBox x:Name="ProcessSearch"
                                         Style="{StaticResource SearchBox}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Поиск по имени или PID"
                                           Margin="34,0,0,0"
                                           FontSize="11.5"
                                           Foreground="#5B6E83"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ProcessSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Border Background="#111B25"
                                    BorderBrush="#22313F"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="10,8"
                                    Margin="8,0,0,0">
                                <TextBlock Text="{Binding VisibleProcessCountText}"
                                           FontSize="10"
                                           Foreground="#8EA1B5" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="16,13,16,8">
                                <TextBlock Text="ЗАГРУЗКА ПРОЦЕССОВ"
                                           FontSize="8.5"
                                           FontWeight="SemiBold"
                                           Foreground="#667A90" />
                                <TextBlock Text="Цветная строка — процесс, на который указывает диагноз"
                                           HorizontalAlignment="Right"
                                           FontSize="9.5"
                                           Foreground="#52657A" />
                            </Grid>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ProcessView}"
                                      Margin="0,0,0,8"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="ПРОЦЕСС" Width="2.4*" SortMemberPath="CpuPercent">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="29" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="26"
                                                            Height="26"
                                                            CornerRadius="7"
                                                            Background="{Binding Accent}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Initials}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="#07111F"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock FontSize="9.5" Foreground="#667A90" Margin="0,1,0,0">
                                                            <Run Text="PID " />
                                                            <Run Text="{Binding Pid, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="CPU"
                                                        Binding="{Binding CpuText, Mode=OneWay}"
                                                        SortMemberPath="CpuPercent"
                                                        Width="0.65*"
                                                        ElementStyle="{StaticResource GridNumberText}" />
                                    <DataGridTextColumn Header="1 ПОТОК"
                                                        Binding="{Binding MaxThreadText, Mode=OneWay}"
                                                        Width="0.8*"
                                                        ElementStyle="{StaticResource GridNumberText}" />
                                    <DataGridTextColumn Header="GPU"
                                                        Binding="{Binding GpuText, Mode=OneWay}"
                                                        SortMemberPath="GpuPercent"
                                                        Width="0.65*"
                                                        ElementStyle="{StaticResource GridNumberText}" />
                                    <DataGridTextColumn Header="VRAM"
                                                        Binding="{Binding VramText, Mode=OneWay}"
                                                        Width="0.85*"
                                                        ElementStyle="{StaticResource GridNumberText}" />
                                    <DataGridTextColumn Header="RAM"
                                                        Binding="{Binding RamText, Mode=OneWay}"
                                                        Width="0.8*"
                                                        ElementStyle="{StaticResource GridNumberText}" />
                                    <DataGridTextColumn Header="ПОТОКИ"
                                                        Binding="{Binding ThreadsText, Mode=OneWay}"
                                                        Width="0.6*"
                                                        ElementStyle="{StaticResource GridNumberText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="«1 поток» — загрузка самого горячего потока относительно одного ядра. 100% означает, что одно ядро занято полностью."
                                   FontSize="10"
                                   Foreground="#667A90" />
                        <TextBlock Text="Данные обновляются каждую секунду"
                                   FontSize="10"
                                   Foreground="#52657A"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>

                <!-- REPORT -->
                <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Report}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition Width="0.85*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <Border Width="46"
                                                Height="46"
                                                CornerRadius="12"
                                                Background="#145B8CFF"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="&#xE8A5;"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="21"
                                                       Foreground="#7DA4FF"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="HTML-отчёт"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="21"
                                                   FontWeight="SemiBold"
                                                   Margin="0,14,0,6" />
                                        <TextBlock Text="Сохраните снимок состояния в момент лага. В отчёте будет вердикт, доказательства, рекомендации и таблица процессов — его можно отправить другу или приложить к обращению."
                                                   FontSize="11.5"
                                                   LineHeight="17"
                                                   Foreground="#9AACBF"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="540" />
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <Button Content="Сохранить HTML"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding SaveReportCommand}" />
                                            <Button Content="Открыть последний"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding OpenLastReportCommand}"
                                                    Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ReportPathText}"
                                                   Margin="0,14,0,0"
                                                   FontSize="10.5"
                                                   Foreground="#74879C"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastError}"
                                                   Margin="0,7,0,0"
                                                   FontSize="10"
                                                   Foreground="#FF5C6C"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LastError}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Content="Открыть папку отчётов"
                                                Style="{StaticResource LinkButton}"
                                                Command="{Binding OpenReportsFolderCommand}"
                                                HorizontalAlignment="Left"
                                                Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="В ОТЧЁТЕ"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#667A90" />
                                        <TextBlock Text="Главный вердикт и доказательства"
                                                   Margin="0,14,0,9"
                                                   FontSize="12"
                                                   Foreground="#C8D6E5" />
                                        <TextBlock Text="Все найденные узкие места"
                                                   Margin="0,0,0,9"
                                                   FontSize="12"
                                                   Foreground="#C8D6E5" />
                                        <TextBlock Text="Пошаговые рекомендации"
                                                   Margin="0,0,0,9"
                                                   FontSize="12"
                                                   Foreground="#C8D6E5" />
                                        <TextBlock Text="Средние и пиковые значения"
                                                   Margin="0,0,0,9"
                                                   FontSize="12"
                                                   Foreground="#C8D6E5" />
                                        <TextBlock Text="Топ процессов и оборудование"
                                                   FontSize="12"
                                                   Foreground="#C8D6E5" />
                                        <Border Height="1" Background="#1A2835" Margin="0,16,0,13" />
                                        <TextBlock Text="Отчёт создаётся локально. LoadLens не отправляет данные в сеть."
                                                   FontSize="10"
                                                   LineHeight="15"
                                                   Foreground="#667A90"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Сессия наблюдения"
                                                   Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding SessionStartedText}"
                                                   HorizontalAlignment="Right"
                                                   FontSize="10"
                                                   Foreground="#667A90"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <UniformGrid Columns="4" Margin="0,13,0,0">
                                        <Border Background="#0BFFFFFF" CornerRadius="9" Padding="12" Margin="0,0,7,7">
                                            <StackPanel>
                                                <TextBlock Text="СРЕДНИЙ CPU" FontSize="8.5" Foreground="#667A90" />
                                                <TextBlock Text="{Binding AvgCpuText}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0BFFFFFF" CornerRadius="9" Padding="12" Margin="0,0,7,7">
                                            <StackPanel>
                                                <TextBlock Text="СРЕДНИЙ GPU" FontSize="8.5" Foreground="#667A90" />
                                                <TextBlock Text="{Binding AvgGpuText}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0BFFFFFF" CornerRadius="9" Padding="12" Margin="0,0,7,7">
                                            <StackPanel>
                                                <TextBlock Text="СРЕДНЯЯ RAM" FontSize="8.5" Foreground="#667A90" />
                                                <TextBlock Text="{Binding AvgRamText}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0BFFFFFF" CornerRadius="9" Padding="12" Margin="0,0,0,7">
                                            <StackPanel>
                                                <TextBlock Text="ДЛИТЕЛЬНОСТЬ" FontSize="8.5" Foreground="#667A90" />
                                                <TextBlock Text="{Binding SessionDurationText}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0BFFFFFF" CornerRadius="9" Padding="12" Margin="0,0,7,0">
                                            <StackPanel>
                                                <TextBlock Text="ПИК CPU" FontSize="8.5" Foreground="#667A90" />
                                                <TextBlock Text="{Binding PeakCpuText}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0BFFFFFF" CornerRadius="9" Padding="12" Margin="0,0,7,0">
                                            <StackPanel>
                                                <TextBlock Text="ПИК GPU" FontSize="8.5" Foreground="#667A90" />
                                                <TextBlock Text="{Binding PeakGpuText}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0BFFFFFF" CornerRadius="9" Padding="12" Margin="0,0,7,0">
                                            <StackPanel>
                                                <TextBlock Text="ПИК RAM" FontSize="8.5" Foreground="#667A90" />
                                                <TextBlock Text="{Binding PeakRamText}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0BFFFFFF" CornerRadius="9" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="ПИК VRAM" FontSize="8.5" Foreground="#667A90" />
                                                <TextBlock Text="{Binding PeakVramText}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <TextBlock Margin="0,12,0,0"
                                               FontSize="9.5"
                                               Foreground="#52657A">
                                        <Run Text="Выборок: " />
                                        <Run Text="{Binding SamplesText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Оборудование"
                                               Style="{StaticResource SectionTitle}" />
                                    <Grid Margin="0,13,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="ПРОЦЕССОР" FontSize="8.5" Foreground="#667A90" />
                                            <TextBlock Text="{Binding HardwareCpuName}" FontSize="12.5" Margin="0,4,12,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding HardwareCpuDetail}" FontSize="10" Foreground="#7C8FA5" Margin="0,3,12,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ВИДЕОКАРТА" FontSize="8.5" Foreground="#667A90" />
                                            <TextBlock Text="{Binding HardwareGpuName}" FontSize="12.5" Margin="0,4,12,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding HardwareGpuDetail}" FontSize="10" Foreground="#7C8FA5" Margin="0,3,12,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="СИСТЕМА" FontSize="8.5" Foreground="#667A90" />
                                            <TextBlock Text="{Binding HardwareRam}" FontSize="12.5" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding HardwareOs}" FontSize="10" Foreground="#7C8FA5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding HardwarePrivileges}" FontSize="10" Foreground="#7C8FA5" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Margin="30,10,30,0"
                    Padding="0,10,0,14"
                    BorderBrush="#16212C"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Данные не покидают компьютер"
                                   FontSize="9.5"
                                   Foreground="#52657A" />
                    </StackPanel>
                    <TextBlock Text="CPU · GPU · RAM · VRAM · диск · потоки"
                               FontSize="9.5"
                               Foreground="#3F5266"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="LoadLens · локальная диагностика"
                               FontSize="9.5"
                               Foreground="#3F5266"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>



